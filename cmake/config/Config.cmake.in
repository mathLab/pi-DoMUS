########################################################################
##                                                                    ##
##               The pidomus project configuration file             ##
##                                                                    ##
########################################################################


#
# General information
#

SET(PIDOMUS_PACKAGE_NAME "@PIDOMUS_PACKAGE_NAME@")
SET(PIDOMUS_PACKAGE_VERSION "@PIDOMUS_PACKAGE_VERSION@")
SET(PIDOMUS_PACKAGE_VENDOR "@PIDOMUS_PACKAGE_VENDOR@")
SET(PIDOMUS_PACKAGE_DESCRIPTION "@PIDOMUS_PACKAGE_DESCRIPTION@")

SET(PIDOMUS_VERSION_MAJOR "@PIDOMUS_VERSION_MAJOR@")
SET(PIDOMUS_VERSION_MINOR "@PIDOMUS_VERSION_MINOR@")
SET(PIDOMUS_VERSION_SUBMINOR "@PIDOMUS_VERSION_SUBMINOR@")
SET(PIDOMUS_VERSION "@PIDOMUS_VERSION@")

SET(PIDOMUS_GIT_BRANCH "@PIDOMUS_GIT_BRANCH@")
SET(PIDOMUS_GIT_REVISION "@PIDOMUS_GIT_REVISION@")
SET(PIDOMUS_GIT_SHORTREV "@PIDOMUS_GIT_SHORTREV@")

SET(PIDOMUS_PROJECT_CONFIG_NAME "@PIDOMUS_PROJECT_CONFIG_NAME@")

SET(PIDOMUS_BUILD_TYPE "@CMAKE_BUILD_TYPE@")
SET(PIDOMUS_BUILD_TYPES "@PIDOMUS_BUILD_TYPES@")


#
# Information about the project location
#

SET(PIDOMUS_DOCHTML_RELDIR "@PIDOMUS_DOCHTML_RELDIR@")
SET(PIDOMUS_DOCREADME_RELDIR "@PIDOMUS_DOCREADME_RELDIR@")
# SET(PIDOMUS_EXAMPLES_RELDIR "@PIDOMUS_EXAMPLES_RELDIR@")
SET(PIDOMUS_EXECUTABLE_RELDIR "@PIDOMUS_EXECUTABLE_RELDIR@")
SET(PIDOMUS_INCLUDE_RELDIR "@PIDOMUS_INCLUDE_RELDIR@")
SET(PIDOMUS_LIBRARY_RELDIR "@PIDOMUS_LIBRARY_RELDIR@")
SET(PIDOMUS_PROJECT_CONFIG_RELDIR "@PIDOMUS_PROJECT_CONFIG_RELDIR@")
SET(PIDOMUS_SHARE_RELDIR "@PIDOMUS_SHARE_RELDIR@")

#
# Determine PIDOMUS_PATH from CMAKE_CURRENT_LIST_DIR:
#

SET(PIDOMUS_PATH "${CMAKE_CURRENT_LIST_DIR}")
SET(_path "${PIDOMUS_PROJECT_CONFIG_RELDIR}")
WHILE(NOT "${_path}" STREQUAL "")
	GET_FILENAME_COMPONENT(PIDOMUS_PATH "${PIDOMUS_PATH}" PATH)
	GET_FILENAME_COMPONENT(_path "${_path}" PATH)
ENDWHILE()

#
# Print a message after inclusion of this file:
#

SET(PIDOMUS_PROJECT_CONFIG_INCLUDED TRUE)

SET(PIDOMUS_BUILD_DIR @CONFIG_BUILD_DIR@)

IF(NOT ${PIDOMUS_PACKAGE_NAME}_FIND_QUIETLY)
  IF(PIDOMUS_BUILD_DIR)
    MESSAGE(STATUS
      "Using the ${PIDOMUS_PACKAGE_NAME}-${PIDOMUS_PACKAGE_VERSION} build directory found at ${PIDOMUS_PATH}"
      )
  ELSE()
    MESSAGE(STATUS
      "Using the ${PIDOMUS_PACKAGE_NAME}-${PIDOMUS_PACKAGE_VERSION} installation found at ${PIDOMUS_PATH}"
      )
  ENDIF()
ENDIF()


#
# Include all convenience macros:
#

FILE(GLOB _macro_files
  "${PIDOMUS_PATH}/${PIDOMUS_SHARE_RELDIR}/macros/*.cmake"
  )
FOREACH(file ${_macro_files})
  IF(NOT ${PIDOMUS_PACKAGE_NAME}_FIND_QUIETLY)
    MESSAGE(STATUS "Include macro ${file}")
  ENDIF()
  INCLUDE(${file})
ENDFOREACH()


#
# Compiler and linker configuration
#

SET(PIDOMUS_CXX_COMPILER "@CMAKE_CXX_COMPILER@")

# used for all targets:
SET(PIDOMUS_CXX_FLAGS "@DEAL_II_CXX_FLAGS@")

# _additionally_ used for debug targets:
SET(PIDOMUS_CXX_FLAGS_DEBUG "@DEAL_II_CXX_FLAGS_DEBUG@")

# _additionally_ used for release targets:
SET(PIDOMUS_CXX_FLAGS_RELEASE "@DEAL_II_CXX_FLAGS_RELEASE@")

# used for all targets:
SET(PIDOMUS_LINKER_FLAGS "@DEAL_II_LINKER_FLAGS@")

# _additionally_ used for debug targets:
SET(PIDOMUS_LINKER_FLAGS_DEBUG "@DEAL_II_LINKER_FLAGS_DEBUG@")

# _additionally_ used for release targets:
SET(PIDOMUS_LINKER_FLAGS_RELEASE "@DEAL_II_LINKER_FLAGS_RELEASE@")

# used for all targets:
SET(PIDOMUS_USER_DEFINITIONS "@PIDOMUS_USER_DEFINITIONS@")

# _additionally_ used for debug targets:
SET(PIDOMUS_USER_DEFINITIONS_DEBUG "@PIDOMUS_USER_DEFINITIONS_DEBUG@")

# _additionally_ used for release targets:
SET(PIDOMUS_USER_DEFINITIONS_RELEASE "@PIDOMUS_USER_DEFINITIONS_RELEASE@")


#
# Information about include directories and libraries
#

# Full list of include directories:
SET(PIDOMUS_INCLUDE_DIRS "@CONFIG_INCLUDE_DIRS@")

# Full list of libraries for the debug target:
SET(PIDOMUS_LIBRARIES_DEBUG "@CONFIG_LIBRARIES_DEBUG@")

# Full list of libraries for the release target:
SET(PIDOMUS_LIBRARIES_RELEASE "@CONFIG_LIBRARIES_RELEASE@")

# Full list of libraries with "debug" and "optimized" keywords for easy use with TARGET_LINK_LIBRARIES:
SET(PIDOMUS_LIBRARIES "@CONFIG_LIBRARIES@")


#
# Information about library targets
#

# The library targets file:
SET(PIDOMUS_TARGET_CONFIG "${PIDOMUS_PATH}/${PIDOMUS_PROJECT_CONFIG_RELDIR}/${PIDOMUS_PROJECT_CONFIG_NAME}Targets.cmake")

# The Debug target:
SET(PIDOMUS_TARGET_DEBUG "@CONFIG_TARGET_DEBUG@")

# The Release target:
SET(PIDOMUS_TARGET_RELEASE "@CONFIG_TARGET_RELEASE@")

# Full list of targets with "debug" and "optimized" keywords for easy use with TARGET_LINK_LIBRARIES:
SET(PIDOMUS_TARGET "@CONFIG_TARGET@")
